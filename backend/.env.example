# ---------------------------------------------------------------------------
# Runway API environment. Copy to `.env` and fill in real values.
# Every variable is validated by backend/src/config/env.ts at boot — a missing
# or placeholder secret is a startup failure, not a runtime surprise.
# Generate secrets with: node ../scripts/generate-secrets.mjs
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Data source ----------------------------------------------------------
# ENABLE_DATABASE=false serves deterministic generated demo data (see
# backend/src/fake-data/) and requires BYPASS_AUTH=true. Production requires
# both to be true; env.ts refuses any other combination.
ENABLE_DATABASE=false
# 127.0.0.1 rather than "localhost": on Windows and Docker Desktop, Node resolves
# "localhost" to ::1 first, and Postgres only ever sees the IPv4 connection, so
# the driver reports "Can't reach database server" while the port is plainly
# listening. Naming the address removes the fallback.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/runway?schema=public"

# --- Auth -----------------------------------------------------------------
# Signs access tokens. Minimum 32 chars; known placeholders are rejected.
JWT_SECRET="replace-with-a-long-random-string"
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh tokens. The browser never sees one: they are opaque random values
# handed out as an httpOnly cookie, and only their SHA-256 hash is stored, so a
# database leak does not hand over working sessions. Every use rotates the
# token, and presenting one that was already spent revokes the whole rotation
# family - that is what turns a stolen cookie into a detectable event instead
# of a silent one.
#
# The expiry is fixed for the life of a login, not extended on each refresh, so
# "signed in for 30 days" means what it says.
REFRESH_TOKEN_TTL_DAYS=30

# The refresh cookie. Scoped to /api/auth so it is not attached to every
# request. COOKIE_SECURE must be true when NODE_ENV=production; env.ts refuses to
# start otherwise, because a non-secure cookie in production is sent in clear
# over any http:// hop. Leave COOKIE_DOMAIN empty unless cookies must be shared
# across subdomains.
REFRESH_COOKIE_NAME=runway_rt
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Demo mode: injects a canned Founder identity and skips JWT verification.
# Hard-refused when NODE_ENV=production.
BYPASS_AUTH=true

# --- CORS -----------------------------------------------------------------
# Comma-separated allowlist. Wildcards are not supported: with cookie-based
# auth, `*` plus credentials is rejected by browsers anyway, and an explicit
# list is the only thing that survives an audit.
CORS_ORIGINS="http://localhost:5173"

# --- Connector credential encryption (required in production) --------------
# AES-256-GCM master key, 32 bytes as hex. Never stored in the database.
CREDENTIALS_MASTER_KEY=""

# --- Logging --------------------------------------------------------------
# Production must emit JSON only; LOG_PRETTY=true is refused in production.
LOG_LEVEL=info
LOG_PRETTY=false

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Credential endpoints (login/register) get their own, much tighter budget.
AUTH_RATE_LIMIT_MAX=10
