# ---------------------------------------------------------------------------
# Runway API environment. Copy to `.env` and fill in real values.
# Every variable is validated by backend/src/config/env.ts at boot — a missing
# or placeholder secret is a startup failure, not a runtime surprise.
# Generate secrets with: node ../scripts/generate-secrets.mjs
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Data source ----------------------------------------------------------
# ENABLE_DATABASE=false serves deterministic generated demo data (see
# backend/src/fake-data/) and requires BYPASS_AUTH=true. Production requires
# both to be true; env.ts refuses any other combination.
ENABLE_DATABASE=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runway?schema=public"

# --- Auth -----------------------------------------------------------------
# Signs access tokens. Minimum 32 chars; known placeholders are rejected.
# Phase 3 moves the session to httpOnly cookies with a rotating refresh token.
JWT_SECRET="replace-with-a-long-random-string"
ACCESS_TOKEN_TTL_SECONDS=900

# Demo mode: injects a canned Founder identity and skips JWT verification.
# Hard-refused when NODE_ENV=production.
BYPASS_AUTH=true

# --- CORS -----------------------------------------------------------------
# Comma-separated allowlist. Wildcards are not supported: with cookie-based
# auth, `*` plus credentials is rejected by browsers anyway, and an explicit
# list is the only thing that survives an audit.
CORS_ORIGINS="http://localhost:5173"

# --- Connector credential encryption (required in production) --------------
# AES-256-GCM master key, 32 bytes as hex. Never stored in the database.
CREDENTIALS_MASTER_KEY=""

# --- Logging --------------------------------------------------------------
# Production must emit JSON only; LOG_PRETTY=true is refused in production.
LOG_LEVEL=info
LOG_PRETTY=false

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Credential endpoints (login/register) get their own, much tighter budget.
AUTH_RATE_LIMIT_MAX=10
