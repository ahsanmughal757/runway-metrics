# --- Core toggles (mirrors Ledgerly's pattern) ---
# When false, every repository layer serves data from the in-memory fake-data
# generator instead of Postgres. Lets the whole app run/demo with zero infra.
ENABLE_DATABASE=false

# When true, auth middleware injects a fixed demo user/company and skips JWT
# verification entirely. Never enable this in a deployed environment.
BYPASS_AUTH=false

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runway?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
